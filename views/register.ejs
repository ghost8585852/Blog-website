<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c&display=swap" rel="stylesheet">
    <style>
       html,body{
         background: linear-gradient(53deg, rgba(3, 3, 3, 1) 11%, rgba(31, 70, 47, 1) 100%, rgba(35, 78, 53, 1) 68%, rgba(32, 72, 49, 1) 34%, rgba(29, 65, 44, 1) 40%, rgba(46, 86, 62, 1) 51%, rgba(41, 75, 54, 1) 85%, rgba(9, 10, 10, 1) 100%, rgba(41, 82, 58, 1) 100%, rgba(18, 18, 14, 1) 100%);
         padding: 0;
         margin: 0;
         height: 100%;
         width: 100%;
         display: flex;
         justify-content: center;
         align-items: center;
         font-family: "M PLUS Rounded 1c", sans-serif;
         font-weight: 400;
         font-style: normal;

        }
        .profile-container{
            background: transparent;
            backdrop-filter: blur(40px);
            height: 500px;
            width: fit-content;
            display: grid;
            grid-template-columns: 400px 400px;
            border-radius: 20px;
            overflow: hidden;
            border: 4px solid rgb(255, 249, 249);
        }
        .img-p{
            object-fit: cover;
            width: 100%;
            height: 100%;
        }
        .mail{
            display: flex;
            flex-direction: column;
        }
        .pass{
            display: flex;
            flex-direction: column;
        }
        .user-name{
            display: flex;
            flex-direction: column;
        }
        .reg-container{
            width: fit-content;
            align-self: center;
            justify-self: center;
            height: 100%;
            
            display: grid;
            grid-template-rows:6 repeat(100px);
           
        }
        .int-email, .int-password-1, .int-password, .int{
            height: 30px;
            border-radius: 20px;
            padding-left: 15px;
            padding-right: 15px;
            font-size: 20px;
            background-color: transparent;
            border: solid white;
            color: white;
        }
        label{
            color: white;
            font-size: 20px;
            margin-bottom: 10px;
        }
        .reg-heading{
            color: rgb(103, 190, 247);
            margin: 0 auto;
            padding: 0;
            font-weight: bold;
            margin-top: 20px;
            
        }
        .submit-regform-btn{
            height: 50px;
            width:100px;
            justify-self:center;
            font-size: 20px;
            border-radius: 20px;
            background: transparent;
            color: white;

        }
        .submit-regform-btn:hover{
            background-color: rgb(103, 190, 247);
            transition: 0.6s;
        }
        .regestration-link{
            color: white;
            justify-self: right;
            font-size: 20px;
            font-weight: bold;
        }
        .regestration-link:hover{
            color: rgb(103, 190, 247) ;
            transition: 0.6s;
        }
        #reg-pass{
            margin-top: 20px;
        }


      
    </style>
</head>
<body>
    
    <div class="profile-container">
        <div>
            <img class="img-p" src="/images/ChatGPT Image Jul 3, 2025, 07_11_23 PM.png" alt="">
        </div>
        <div  class="reg-container">
            <h1 class="reg-heading">Register</h1>
            <div class="user-name">
                <label for="user-name" name="user-name">Name:</label>
                <input class="int" type="text" name="user-name" placeholder="Type your name">

            </div>
            <div class="mail">
              <label for="email"  name="email"  >Email:</label>
              <input class="int-email" type="email" name="email" placeholder="Type your mail">  
            </div>
            <div class="pass">
               <label for="password" name="password">Password:</label>
               <input  class="int-password-1" type="password" name="password" placeholder="Type your password">
               <input  id="reg-pass" class="int-password" type="password" name="password" placeholder="Re-enter your password">

            </div>
            <input class="submit-regform-btn" type="submit" name="submit" value="Register"> 
            <a href="/" class="regestration-link" >Login</a>
            
            
        </div>
    

    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/functions/passsword.js" charset="UTF-8"></script>


    
</body>
</html>