<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c&display=swap" rel="stylesheet">
    <style>
       html,body{
         background: linear-gradient(53deg, rgba(3, 3, 3, 1) 11%, rgba(31, 70, 47, 1) 100%, rgba(35, 78, 53, 1) 68%, rgba(32, 72, 49, 1) 34%, rgba(29, 65, 44, 1) 40%, rgba(46, 86, 62, 1) 51%, rgba(41, 75, 54, 1) 85%, rgba(9, 10, 10, 1) 100%, rgba(41, 82, 58, 1) 100%, rgba(18, 18, 14, 1) 100%);
         padding: 0;
         margin: 0;
         height: 100%;
         width: 100%;
         display: flex;
         justify-content: center;
         align-items: center;
         font-family: "M PLUS Rounded 1c", sans-serif;
         font-weight: 400;
         font-style: normal;

        }
        .profile-container{
            background: transparent;
            backdrop-filter: blur(40px);
            height: 500px;
            width: fit-content;
            display: grid;
            grid-template-columns: 400px 400px;
            
            overflow: hidden;
            border:  4px solid white ;
            border-radius: 20px;
        }
        .img-p{
            object-fit: cover;
            width: 100%;
            height: 100%;
        }
        .mail{
            display: flex;
            flex-direction: column;
        }
        .pass{
            display: flex;
            flex-direction: column;
        }
        .login-container{
            width: 90%;
            justify-self: center;
            margin-top: 30px;
            height: 84%;
            display: grid;
            grid-template-rows: 100px 100px 100px 100px;
           
        }
        .int-m, .int-p{
            height: 40px;
            border-radius: 20px;
            padding-left: 15px;
            padding-right: 15px;
            font-size: 20px;
            background-color: transparent;
            border: solid white;
            color: white;
        }
        label{
            color: white;
            font-size: 20px;
            margin-bottom: 10px;
        }
        .login-heading{
            color: rgb(103, 190, 247);
            margin: 0 auto;
            padding: 0;
            font-weight: bold;
            
        }
        .submit-loginform-btn{
            height: 50px;
            width:100px;
            justify-self:center;
            font-size: 20px;
            border-radius: 20px;
            background: transparent;
            margin-top: 20px;
            color: white;

        }
        .submit-loginform-btn:hover{
            background-color: rgb(103, 190, 247);
            transition: 0.6s;
        }
        .regestration-link{
            color: white;
            justify-self: right;
            font-size: 20px;
            font-weight: bold;
        }
        .regestration-link:hover{
            color:rgb(103, 190, 247);
            transition: 0.6s;
        }


      
    </style>
</head>
<body>
    
    <div class="profile-container">
        <div>
            <img class="img-p" src="/images/ChatGPT Image Jul 3, 2025, 07_11_23 PM.png" alt="">
        </div>
        <form action="/Home" method="POST" id="login-whole">
         <div  class="login-container">
            <h1 class="login-heading">LOGIN</h1>
            <div class="mail">
              <label for="email"  name="email"  >Email:</label>
              <input class="int-m" type="email" name="email" placeholder="Type your mail">  
            </div>
            <div class="pass">
               <label for="password" name="password">Password:</label>
               <input class="int-p" type="password" name="password" placeholder="Type your password">
               
            </div>
            <input class="submit-loginform-btn" type="submit" name="submit" value="Login" > 
            <a href="/register" class="regestration-link" >Create New Profile</a>
            
            
         </div>
        </form>

    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/functions/log.js"></script>

    
</body>
</html>
